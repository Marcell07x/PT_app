<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) draws its own system splash screen. These
         attributes make it match the app splash: the bokeh base colour behind
         the centred logo mark, so there is no white flash before Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
